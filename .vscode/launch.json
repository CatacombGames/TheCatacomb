{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "The Catacomb — debug",
      "request": "launch",
      "type": "lldb",
      "program": "${workspaceFolder}/bin/macos-debug/catacomb",
      "cwd": "${config:catacomb.dataDir}",
      "args": [],
